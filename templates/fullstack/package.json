{
	"name": "svelteforge-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "latest",
		"@skeletonlabs/skeleton-svelte": "latest",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "latest",
		"drizzle-kit": "latest",
		"jsdom": "^29.1.1",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@fontsource-variable/fira-code": "latest",
		"@fontsource-variable/inter": "latest",
		"@fontsource-variable/manrope": "latest",
		"@fontsource-variable/space-grotesk": "latest",
		"@tiptap/core": "latest",
		"@tiptap/extension-underline": "latest",
		"@tiptap/starter-kit": "latest",
		"clsx": "latest",
		"phosphor-svelte": "^3.1.0",
		"pino": "latest",
		"pino-pretty": "latest",
		"sveltekit-superforms": "latest",
		"tailwind-merge": "latest",
		"zod": "latest"
	}
}
