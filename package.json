{
  "name": "svforge-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter svforge build",
    "build:all": "bun run --filter '*' build",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "release:plan": "node scripts/release-plan.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "jsdom": "^30.0.1",
    "sv": "0.15.4",
    "svelte": "^5",
    "vitest": "^3.1.1",
    "ws": "^8.21.3"
  }
}
