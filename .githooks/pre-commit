#!/bin/sh
# Graphify knowledge-graph pre-commit hook.
#
# Contract: the commit must carry a knowledge graph that describes exactly
# the code IN the commit. `graphify update .` reads the working tree, so a
# partially staged commit would otherwise bake a graph of unseen code into
# the commit. To keep that impossible:
#
#   1. if any source file has unstaged modifications (worktree vs index),
#      the commit is REFUSED with a clear message — stage or stash first;
#   2. otherwise the worktree equals the index, and running the local,
#      deterministic update (`graphify update . --no-cluster`) describes the
#      staged snapshot exactly.
#
# Untracked files are not part of the commit and graphify indexes them too,
# so untracked source files must also be absent — they are listed in the
# refusal message.
#
# Staging is pathspec-limited to graphify-out/ tracked files — never a
# blanket `git add .`. If the update produced no diff, there is simply
# nothing to stage and the commit proceeds unchanged.

set -eu

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if ! command -v graphify >/dev/null 2>&1; then
	echo "graphify: command not found — the knowledge graph cannot be updated." >&2
	echo "Install it with:" >&2
	echo "  uv tool install graphifyy" >&2
	echo "(package: graphifyy, executable: graphify; then retry the commit)" >&2
	exit 1
fi

unstaged="$(git diff --name-only --diff-filter=ACMR -- . ':!graphify-out')"
untracked="$(git ls-files --others --exclude-standard -- . ':!graphify-out')"

if [ -n "$unstaged" ] || [ -n "$untracked" ]; then
	echo "commit refused: the graph must describe the code in this commit, but:" >&2
	[ -n "$unstaged" ] && {
		echo "  unstaged source modifications:" >&2
		echo "$unstaged" | sed 's/^/    /' >&2
	}
	[ -n "$untracked" ] && {
		echo "  untracked source files (graphify indexes them):" >&2
		echo "$untracked" | sed 's/^/    /' >&2
	}
	echo "Stage (git add) or remove these, or commit with --no-verify for graph-only work." >&2
	exit 1
fi

# Regenerate the graph from THIS worktree/index snapshot. --no-cluster keeps
# the run fully deterministic and local (clustering would invoke LLM
# community naming).
graphify update . --no-cluster >/dev/null

# Scrub machine-local data (mtimes, absolute-path-derived ids) so the
# committed graph is byte-stable across machines, clones and worktrees.
node "$repo/scripts/normalize-graphify.mjs" >/dev/null

# Stage updates and deletions of already-tracked graph files, plus the
# canonical graph set in case a file was regenerated from scratch.
git add -u -- graphify-out
for canonical in graphify-out/graph.json graphify-out/manifest.json; do
	[ -f "$canonical" ] && git add -- "$canonical"
done

if ! git diff --cached --quiet -- graphify-out; then
	echo "graphify: staged updated knowledge graph from graphify-out/"
fi
