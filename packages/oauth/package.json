{
	"name": "@svforge/oauth",
	"version": "0.0.1",
	"type": "module",
	"description": "SVForge OAuth — social auth (Google, GitHub)",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svelteforge.git",
		"directory": "packages/oauth"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^0.13.0"
	},
	"devDependencies": {
		"sv": "^0.15.3",
		"tsdown": "^0.12.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"prebuild": "bun scripts/prebuild.ts",
		"build": "bun run prebuild && bunx tsdown && cp dist/index-*.d.ts dist/index.d.ts 2>/dev/null || true",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"sv-add",
		"svforge",
		"oauth",
		"social-auth",
		"google",
		"github",
		"better-auth",
		"svelte",
		"sveltekit"
	]
}
