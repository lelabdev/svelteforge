{
	"name": "@svforge/jobs",
	"version": "2.0.0",
	"type": "module",
	"description": "SVForge Jobs — background job foundation (encapsulated backend, retry, progress)",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svelteforge.git",
		"directory": "packages/jobs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^0.13.0"
	},
	"devDependencies": {
