# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# SvelteForge dashboard uses PostgreSQL + Drizzle. Pick one:

# Local PostgreSQL (installed on your machine)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/sf_dashboard"

# PostgreSQL via Docker (reproducible dev setup)
#   docker run --name sf-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=sf_dashboard \
#     -p 5432:5432 -d postgres:17
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/sf_dashboard"

# Managed PostgreSQL (Neon / Supabase / Railway / RDS…)
#   paste the connection string from your provider — it already contains
#   user, password, host and database.
# DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Better Auth
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=changeme

# Sign-up policy (#318) — enforced SERVER-side, never by the UI:
# - closed (default)     no public sign-up; admins create users from /admin/users
# - invite-only          only pre-approved emails (invited from /admin/users) can register
# - self-service         anyone can register — admins are ONLY ever explicit (role column)
# Unknown values fall back to closed. Change requires a server restart.
SIGNUP_MODE=closed

# First-admin bootstrap command (atomic, fails if an admin already exists):
#   bun run admin:create -- --name "Admin" --email admin@example.com --password '…'
# (or ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD environment variables)

# Notes:
# - Generate a strong secret: openssl rand -base64 32
# - ORIGIN must match your dev server URL
# - Create the database first if it doesn't exist:
#     createdb sf_dashboard
#   or via Docker: POSTGRES_DB=sf_dashboard in the container env.
