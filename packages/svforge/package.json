{
	"name": "svforge",
	"version": "1.2.0",
	"type": "module",
	"description": "sv community addon \u2014 SvelteKit starter templates with Skeleton UI, Tailwind CSS, Better Auth, and Drizzle ORM",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svelteforge.git",
		"directory": "packages/svforge"
	},
	"homepage": "https://github.com/lelabdev/svelteforge#readme",
	"bugs": "https://github.com/lelabdev/svelteforge/issues",
	"types": "./dist/index.d.ts",
	"bin": {
		"svforge": "./bin/svforge.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"bin/"
	],
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit",
		"boilerplate",
		"skeleton-ui",
		"tailwindcss",
		"ui-components",
		"starter",
		"template"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^0.13.0"
	},
	"devDependencies": {
		"sv": "^0.15.3",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"prebuild": "bun scripts/prebuild.ts",
		"build": "bun run prebuild && tsdown",
		"prepublishOnly": "bun run build"
	}
}
